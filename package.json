{
  "name": "insomnia",
  "private": true,
  "version": "1.0.0",
  "author": "Kong <office@konghq.com>",
  "description": "Insomnia is a cross-platform REST client, built on top of Electron.",
  "license": "Apache-2.0",
  "repository": "https://github.com/kong/insomnia",
  "bugs": {
    "url": "https://github.com/kong/insomnia/issues"
  },
  "homepage": "https://github.com/kong/insomnia#readme",
  "engines": {
    "node": "v26.5.1",
    "npm": "12.0.2"
  },
  "workspaces": [
    "packages/insomnia-testing",
    "packages/insomnia",
    "packages/insomnia-data",
    "packages/insomnia-analytics",
    "packages/insomnia-api",
    "packages/insomnia-inso",
    "packages/insomnia-smoke-test",
    "packages/insomnia-scripting-environment"
  ],
  "scripts": {
    "dev": "npm start -w insomnia",
    "dev:autoRestart": "npm run start:autoRestart -w insomnia",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "git clean -dfX",
    "install-libcurl-electron": "node scripts/install-libcurl.mjs electron",
    "install-libcurl-node": "node scripts/install-libcurl.mjs node",
    "test:inso:bundle": "node scripts/run-inso-smoke-tests.mjs bundle",
    "test:inso:binary": "node scripts/run-inso-smoke-tests.mjs binary",
    "kill-smoke-servers": "node scripts/kill-smoke-servers.mjs",
    "inso-start": "npm start -w insomnia-inso",
    "inso-package": "npm run build -w insomnia-inso && npm run package -w insomnia-inso",
    "watch:app": "npm run build:electron-entrypoints -w insomnia && npm run start:dev-server -w insomnia",
    "app-build": "npm run build -w insomnia",
    "app-package": "npm run package -w insomnia",
    "test:smoke:dev": "npm run test:dev -w insomnia-smoke-test -- --project=Smoke",
    "test:smoke:build": "npm run test:build -w insomnia-smoke-test -- --project=Smoke",
    "test:smoke:package": "npm run test:package -w insomnia-smoke-test -- --project=Smoke",
    "test:crit:package": "npm run test:package -w insomnia-smoke-test -- --project=Critical",
    "test:crit:dev": "npm run test:dev -w insomnia-smoke-test -- --project=Critical",
    "postinstall": "patch-package && node scripts/ensure-optional-native-deps.mjs && npm run verify-bundle-plugins -w insomnia && npm run install-libcurl-electron",
    "check-cycle-references": "madge --circular --extensions ts,tsx packages",
    "tsc7": "node node_modules/@typescript/native/bin/tsc"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/har-format": "1.2.16",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "esbuild": "0.28.1",
    "esbuild-runner": "2.2.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "17.8.0",
    "graphql": "17.0.2",
    "madge": "8.0.0",
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tslib": "2.8.1",
    "type-fest": "5.8.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@stoplight/types": "14.1.1",
    "@xmldom/xmldom": "0.9.10",
    "ajv-draft-04": {
      "ajv": "$ajv"
    },
    "commander": "15.0.0",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "iconv-lite": "0.7.3",
    "ip-address": "10.4.0",
    "log-symbols": {
      "is-unicode-supported": "0.1.0"
    },
    "js-yaml": "5.2.2",
    "mime-types": "3.0.2",
    "minimatch": "10.2.6",
    "protobufjs": "8.7.1",
    "semver": "7.8.5",
    "serialize-javascript": "7.0.7",
    "undici": "8.9.0",
    "uuid": "14.0.1"
  },
  "dependencies": {
    "@getinsomnia/node-libcurl": "3.3.0",
    "ajv": "8.20.0"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "node-llama-cpp@3.18.1": true,
    "protobufjs@7.6.5": true,
    "protobufjs@8.7.1": true
  }
}
