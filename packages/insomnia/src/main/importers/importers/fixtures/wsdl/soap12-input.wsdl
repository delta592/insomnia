<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
                  xmlns:tns="http://example.com/soap12"
                  xmlns:s="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="http://example.com/soap12">
  <wsdl:types>
    <s:schema elementFormDefault="qualified" targetNamespace="http://example.com/soap12">
      <s:element name="Ping">
        <s:complexType>
          <s:sequence>
            <s:element name="message" type="s:string" minOccurs="1" maxOccurs="1"/>
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="PingResponse">
        <s:complexType>
          <s:sequence>
            <s:element name="PingResult" type="s:string" minOccurs="1" maxOccurs="1"/>
          </s:sequence>
        </s:complexType>
      </s:element>
    </s:schema>
  </wsdl:types>
  <wsdl:message name="PingSoapIn">
    <wsdl:part name="parameters" element="tns:Ping"/>
  </wsdl:message>
  <wsdl:message name="PingSoapOut">
    <wsdl:part name="parameters" element="tns:PingResponse"/>
  </wsdl:message>
  <wsdl:portType name="PingSoap">
    <wsdl:operation name="Ping">
      <wsdl:documentation>Ping via SOAP 1.2</wsdl:documentation>
      <wsdl:input message="tns:PingSoapIn"/>
      <wsdl:output message="tns:PingSoapOut"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="PingSoap12" type="tns:PingSoap">
    <soap12:binding transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Ping">
      <soap12:operation soapAction="http://example.com/soap12/Ping" style="document"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="Soap12Service">
    <wsdl:port name="PingSoap12" binding="tns:PingSoap12">
      <soap12:address location="http://example.com/soap12"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
